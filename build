#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

# Detect CPU for llc
detect_mcpu() {
	if [[ "$(uname -m)" == "arm64" || "$(uname -m)" == "aarch64" ]]; then
		# Try apple-m4, fall back to apple-m1, fall back to generic
		for cpu in apple-m4 apple-m1 generic; do
			if nix develop -c llc -mcpu="$cpu" -mtriple=aarch64-apple-darwin /dev/null -o /dev/null 2>/dev/null; then
				echo "$cpu"
				return
			fi
		done
		echo "generic"
	else
		echo "generic"
	fi
}

OPT="${1:--O2}"
MCPU="$(detect_mcpu)"
TRIPLE=""
if [[ "$(uname -m)" == "arm64" || "$(uname -m)" == "aarch64" ]]; then
	TRIPLE="-mtriple=aarch64-apple-darwin"
fi

echo "Building with -mcpu=$MCPU $OPT"

# Assemble LLVM IR to object file
nix develop -c llc "$OPT" -mcpu="$MCPU" $TRIPLE -filetype=obj chudnovsky.ll -o chudnovsky.o

if [[ "${PGO:-}" == "1" ]]; then
	echo "Building with PGO (two-pass)..."

	# Pass 1: instrumented build
	nix develop -c clang "$OPT" -flto -fprofile-generate -I"$GMP_INCLUDE" -c main.c -o main.o
	nix develop -c clang -O3 -flto -fprofile-generate -I"$GMP_INCLUDE" -c sieve.c -o sieve.o
	nix develop -c clang "$OPT" -flto -fprofile-generate main.o chudnovsky.o sieve.o -L"$GMP_LIB" -lgmp -o pi

	# Profile run
	./pi 1000000 > /dev/null
	nix develop -c llvm-profdata merge -output=default.profdata *.profraw
	rm -f *.profraw

	# Pass 2: optimized build
	nix develop -c clang "$OPT" -flto -fprofile-use=default.profdata -I"$GMP_INCLUDE" -c main.c -o main.o
	nix develop -c clang -O3 -flto -fprofile-use=default.profdata -I"$GMP_INCLUDE" -c sieve.c -o sieve.o
	nix develop -c clang "$OPT" -flto -fprofile-use=default.profdata main.o chudnovsky.o sieve.o -L"$GMP_LIB" -lgmp -o pi
	rm -f default.profdata
else
	# Standard build with LTO
	nix develop -c clang "$OPT" -flto -I"$GMP_INCLUDE" -c main.c -o main.o
	nix develop -c clang -O3 -flto -I"$GMP_INCLUDE" -c sieve.c -o sieve.o
	nix develop -c clang "$OPT" -flto main.o chudnovsky.o sieve.o -L"$GMP_LIB" -lgmp -o pi
fi

echo "Built: ./pi"
