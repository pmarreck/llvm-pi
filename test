#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

PASS=0
FAIL=0
PI_REF="$(cat pi_reference.txt)"

run_test() {
	local digits="$1"
	local label="$2"
	# Expected: "3." + first $digits decimal digits from reference
	local expected
	expected="${PI_REF:0:$((digits + 2))}"  # "3." = 2 chars

	local actual
	actual="$(nix develop -c ./pi "$digits" 2>&1)" || {
		echo "FAIL [$label]: pi $digits crashed"
		FAIL=$((FAIL + 1))
		return
	}

	# Trim trailing whitespace/newlines from actual
	actual="$(echo -n "$actual" | tr -d '\n')"

	# Compare: actual must match expected exactly
	if [[ "$actual" == "$expected" ]]; then
		echo "PASS [$label]: $digits digits match"
		PASS=$((PASS + 1))
	else
		echo "FAIL [$label]: $digits digits mismatch"
		echo "  expected (first 60): ${expected:0:60}..."
		echo "  actual   (first 60): ${actual:0:60}..."
		# Show first divergence point
		local i
		for ((i=0; i<${#expected} && i<${#actual}; i++)); do
			if [[ "${expected:$i:1}" != "${actual:$i:1}" ]]; then
				echo "  first diff at position $i: expected '${expected:$i:1}' got '${actual:$i:1}'"
				break
			fi
		done
		FAIL=$((FAIL + 1))
	fi
}

# Hardcoded pi prefix — independent of pi_reference.txt
# Source: first 50 decimals of pi are universally agreed upon
KNOWN_PI="3.14159265358979323846264338327950288419716939937510"

# Verify pi_reference.txt itself starts with known pi digits
if [[ "${PI_REF:0:52}" != "$KNOWN_PI" ]]; then
	echo "FATAL: pi_reference.txt does not start with known pi digits!"
	echo "  expected: $KNOWN_PI"
	echo "  got:      ${PI_REF:0:52}"
	exit 1
fi

# Build first
echo "=== Building ==="
nix develop -c bash -c './build' || { echo "Build failed"; exit 1; }
echo

echo "=== Running tests ==="

# First: verify output starts with hardcoded known pi (catches pi/2 bugs etc.)
actual_check="$(nix develop -c ./pi 50 2>&1 | tr -d '\n')"
if [[ "$actual_check" != "$KNOWN_PI" ]]; then
	echo "FAIL [hardcoded-pi]: output does not match known pi digits"
	echo "  expected: $KNOWN_PI"
	echo "  got:      $actual_check"
	FAIL=$((FAIL + 1))
else
	echo "PASS [hardcoded-pi]: output starts with known pi"
	PASS=$((PASS + 1))
fi

run_test 50 "sanity-50"
run_test 100 "basic-100"
run_test 1000 "medium-1000"
run_test 10000 "stress-10k"
run_test 100000 "stress-100k"

echo
echo "=== Results: $PASS passed, $FAIL failed ==="
exit "$FAIL"
